{
  "name": "powerbi-visuals-utils-chartutils",
  "version": "8.4.0",
  "description": "ChartUtils",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microsoft/powerbi-visuals-utils-chartutils.git"
  },
  "keywords": [
