    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "powerbi-visuals-utils-formattingutils": "^7.0.0",
    "powerbi-visuals-utils-svgutils": "^7.0.0",
    "powerbi-visuals-utils-typeutils": "^7.0.0"
  }
